# Auto-detect text files and normalize line endings
* text=auto

# C++ Source and Header files
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Markdown and Documentation
*.md text eol=lf
*.txt text eol=lf

# Windows scripts (require CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.onnx binary
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
