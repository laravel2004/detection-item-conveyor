# Contoh Konfigurasi Kamera RTSP
# Salin file ini menjadi .env jika diperlukan, atau set via Environment Variable

# URL RTSP Kamera
SACK_RTSP_URL=rtsp://username:password@192.168.1.100:554/Streaming/Channels/101

# Path Model YOLO ONNX (Opsional, default otomatis mencari best.onnx)
# SACK_MODEL_PATH=C:/dev/cpp_rtsp/best.onnx
